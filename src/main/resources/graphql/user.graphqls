extend type Query {
    user(id: ID!): UserResponse
    users(page: Int! = 0, size: Int! = 4, sortBy: String! = "id"): [UserResponse]
}

extend type Mutation {
    createUser(input: CreateUserRequest): UserResponse
    deleteUser(id: ID!): Void
    updateUserPassword(id: ID!, password: String): UserResponse
}

type UserResponse {
    name: String!,
    email: String!
}

input CreateUserRequest {
    name: String!,
    email: String!,
    password: String!
}

scalar Void